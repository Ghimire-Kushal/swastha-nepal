# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get these from console.neon.tech → your project → Connection Details
# "Pooled connection" string goes in DATABASE_URL (used at runtime)
# "Direct connection" string goes in DIRECT_URL (used only for migrations)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/swastha_nepal?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/swastha_nepal?sslmode=require"

# For local development only (no Neon):
# DATABASE_URL="postgresql://kushal@localhost:5432/swastha_nepal"
# DIRECT_URL="postgresql://kushal@localhost:5432/swastha_nepal"

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# ─── AI (Anthropic Claude) ────────────────────────────────────────────────────
# Get from console.anthropic.com → API Keys
# The app works in demo mode without a real key
ANTHROPIC_API_KEY="sk-ant-YOUR_KEY_HERE"

# ─── File Storage (Cloudinary) ────────────────────────────────────────────────
# Get from cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ─── App URL (set on Vercel automatically) ────────────────────────────────────
# NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ─── Node environment ─────────────────────────────────────────────────────────
NODE_ENV="development"
